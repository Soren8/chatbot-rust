{
  "name": "PROJECT_NAME (agent-safe)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "remoteUser": "agent",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "CARGO_HOME": "/mnt/linux-data/.cargo/home",
    "CARGO_HOME_OVERRIDE": "/mnt/linux-data/.cargo/home",
    "CARGO_INSTALL_ROOT": "/home/agent/.cargo",
    "CARGO_BUILD_BUILD_DIR": "/mnt/linux-data/.cargo/target/{workspace-path-hash}",
    "CARGO_TARGET_DIR": "/workspace/temp/.cargo/target",
    "RUSTUP_HOME": "/home/agent/.rustup",
    "INSTALL_GROK": "1"
  },
  "mounts": [
    "source=/mnt/linux-data/.cargo/home,target=/mnt/linux-data/.cargo/home,type=bind",
    "source=/mnt/linux-data/.cargo/target,target=/mnt/linux-data/.cargo/target,type=bind"
  ],
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "serayuzgur.crates"
      ],
      "settings": {
        "rust-analyzer.cargo.targetDir": "/workspace/temp/.cargo/target"
      }
    }
  },
  "remoteEnv": {
    "PATH": "/home/agent/.grok/bin:${containerEnv:PATH}"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": false
    }
  },
  "runArgs": ["--init"],
  "postStartCommand": "echo 'Docker socket available: docker compose build / run tests from /workspace.'"
}