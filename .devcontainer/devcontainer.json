{
  "name": "chatbot-rust (agent-safe)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "remoteUser": "agent",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "CARGO_HOME": "/mnt/linux-data/.cargo/home",
    "CARGO_HOME_OVERRIDE": "/mnt/linux-data/.cargo/home",
    "CARGO_INSTALL_ROOT": "/home/agent/.cargo",
    "CARGO_BUILD_BUILD_DIR": "/mnt/linux-data/.cargo/target/{workspace-path-hash}",
    "CARGO_TARGET_DIR": "/workspace/temp/.cargo/target",
    "RUSTUP_HOME": "/home/agent/.rustup",
    "INSTALL_GROK": "1"
  },
  "mounts": [
    "source=/mnt/linux-data/.cargo/home,target=/mnt/linux-data/.cargo/home,type=bind",
    "source=/mnt/linux-data/.cargo/target,target=/mnt/linux-data/.cargo/target,type=bind",
    "source=${localWorkspaceFolder}/.devcontainer/stubs/.env,target=/workspace/.env,type=bind,readonly,consistency=consistent",
    "source=${localWorkspaceFolder}/.config.yml.example,target=/workspace/.config.yml,type=bind,readonly",
    "source=${localWorkspaceFolder}/.devcontainer/stubs/data,target=/workspace/data,type=bind,readonly"
  ],
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "serayuzgur.crates"
      ],
      "settings": {
        "rust-analyzer.cargo.targetDir": "/workspace/temp/.cargo/target"
      }
    }
  },
  "remoteEnv": {
    "PATH": "/home/agent/.grok/bin:${containerEnv:PATH}",
    "HOST_PROJECT_DIR": "${localWorkspaceFolder}"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": false
    }
  },
  "runArgs": ["--init"],
  "postStartCommand": "echo 'Tests: docker compose run --rm tests. Live webserver/voice: host operator only (not from this sandbox).'"
}